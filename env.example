# Environment Variables for DC SiteLab
# Copy this file to .env.local and fill in your values.
# The app works without any API keys in Demo Mode.

# ──────────────────────────────────────────────
# DATABASE (optional for MVP - persistence features)
# ──────────────────────────────────────────────
# Supabase or any PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dc_sitelab"

# ──────────────────────────────────────────────
# MOCK / DEMO MODE
# ──────────────────────────────────────────────
# Set to "true" to use mock providers (no API calls required)
# Leave empty or "false" to use real API providers
NEXT_PUBLIC_MOCK_MODE="true"

# ──────────────────────────────────────────────
# REAL API PROVIDERS (all optional, open-source APIs)
# ──────────────────────────────────────────────

# Open-Meteo: Free, no key required
# https://open-meteo.com
# (no key needed)

# Open-Elevation: Free, no key required
# https://api.open-elevation.com
# (no key needed)

# OpenStreetMap / Nominatim: Free, no key required
# https://nominatim.openstreetmap.org
# Set a descriptive user agent below (required by OSM policy)
NOMINATIM_USER_AGENT="DC-SiteLab/1.0 (your-email@example.com)"

# Overpass API: Free, no key required
# https://overpass-api.de
# (no key needed)

# ──────────────────────────────────────────────
# MAPBOX (optional - for premium map tiles)
# Without this, the app uses free OpenStreetMap tiles
# ──────────────────────────────────────────────
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# ──────────────────────────────────────────────
# APP CONFIG
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DC SiteLab"

# ──────────────────────────────────────────────
# VERCEL DEPLOYMENT
# ──────────────────────────────────────────────
# When deploying to Vercel, set DATABASE_URL in the Vercel dashboard
# under Project Settings → Environment Variables.
# Set NEXT_PUBLIC_MOCK_MODE="false" in production if you want live API calls.

# ──────────────────────────────────────────────
# API RATE LIMITING (optional)
# ──────────────────────────────────────────────
# If you deploy and want to cache provider results:
# PROVIDER_CACHE_TTL_HOURS="24"
